generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  password           String?
  role               String        @default("jobseeker")
  avatar             String?
  resume             String?
  clerkId            String?       @unique
  companyName        String?
  companyDescription String?
  companyLogo        String?
  // Existing employer accounts default to complete so this onboarding launch
  // only gates employers created after it is introduced.
  employerOnboardingComplete    Boolean   @default(true)
  employerOnboardingCompletedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents          Document[]
  postedJobs         Job[]         @relation("EmployerJobs")
  applications       Application[] @relation("ApplicantApplications")
  savedJobs          SavedJob[]
  analytics          Analytics?
  company            Company?

  @@index([email])
  @@index([clerkId])
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  url          String
  category     String   @default("Other")
  fileType     String?
  size         Int?
  publicId     String?
  resourceType String?
  uploadedAt   DateTime @default(now())

  @@index([userId])
}

// Company profile — rich employer-managed company page
model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  logo        String?
  cover       String?
  description String?
  hq          String?
  stage       String?
  employees   String?
  industry    String?
  website     String?
  legalName   String?
  organizationType String?
  registrationNumber String?
  contactName String?
  contactTitle String?
  contactEmail String?
  contactPhone String?
  authorityConfirmedAt DateTime?
  termsAcceptedAt DateTime?
  hiringPolicyAcceptedAt DateTime?
  rating      Float?   @default(0)
  verified    Boolean  @default(false)
  stack       String[]
  perks       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]    @relation("CompanyJobs")

  @@index([industry])
}

model Job {
  id               String        @id @default(cuid())
  title            String
  description      String
  requirements     String
  location         String?
  latitude         Float?
  longitude        Float?
  category         String?
  customCategory   String?
  tags             String[]      @default([])
  type             String
  workModel        String?
  customJobType    String?
  deadline         DateTime?
  companyId        String
  company          User          @relation("EmployerJobs", fields: [companyId], references: [id], onDelete: Cascade)
  companyProfileId String?
  companyProfile   Company?      @relation("CompanyJobs", fields: [companyProfileId], references: [id], onDelete: SetNull)
  salaryMin        Float?
  salaryMax        Float?
  isClosed         Boolean       @default(false)
  jobType          String?
  companyLogo      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications     Application[]
  savedBy          SavedJob[]

  @@index([companyId])
  @@index([companyProfileId])
  @@index([category])
  @@index([isClosed])
}

model Application {
  id                String    @id @default(cuid())
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId       String?
  applicant         User?     @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: SetNull)
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  resume            String
  coverLetter       String?
  coverLetterFile   String?
  status            String    @default("Applied")
  interviewDate     DateTime?
  interviewTime     String?
  interviewLocation String?
  interviewNotes    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([jobId])
  @@index([applicantId])
}

model SavedJob {
  id          String   @id @default(cuid())
  jobSeekerId String
  jobSeeker   User     @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([jobSeekerId, jobId])
  @@index([jobSeekerId])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @default("")
  subject     String
  html        String
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Analytics {
  id                String   @id @default(cuid())
  employerId        String   @unique
  employer          User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  totalJobsPosted   Int      @default(0)
  totalApplications Int      @default(0)
  totalHired        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Salary benchmark data — admin-managed market compensation data
model SalaryBenchmark {
  id        String   @id @default(cuid())
  role      String
  location  String?
  sector    String?
  tenure    String?
  p25       Float
  median    Float
  p75       Float
  p90       Float
  currency  String   @default("GH₵")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Skill premium data — admin-managed
model SkillPremium {
  id        String   @id @default(cuid())
  skill     String
  premium   String
  demand    String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anonymous salary submissions from users
model SalarySubmission {
  id           String   @id @default(cuid())
  role         String
  compensation String
  experience   String
  location     String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
}
