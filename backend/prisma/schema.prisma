generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  password           String?
  role               String        @default("jobseeker")
  avatar             String?
  resume             String?
  clerkId            String?       @unique
  companyName        String?
  companyDescription String?
  companyLogo        String?
  // Existing employer accounts default to complete so this onboarding launch
  // only gates employers created after it is introduced.
  employerOnboardingComplete    Boolean   @default(true)
  employerOnboardingCompletedAt DateTime?
  // clear | flagged | suspended. A suspended recruiter cannot publish jobs.
  trustState         String        @default("clear")
  trustReviewedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents          Document[]
  postedJobs         Job[]         @relation("EmployerJobs")
  applications       Application[] @relation("ApplicantApplications")
  savedJobs          SavedJob[]
  analytics          Analytics?
  company            Company?
  candidateProfile   CandidateProfile?
  resumeAnalyses     ResumeAnalysis[]
  jobMatches         JobMatch[]
  hiringPipeline     HiringPipeline?
  talentInvitesSent     TalentInvite[] @relation("TalentInvitesSent")
  talentInvitesReceived TalentInvite[] @relation("TalentInvitesReceived")
  assessments           Assessment[]   @relation("EmployerAssessments")
  assessmentAttempts    AssessmentAttempt[] @relation("CandidateAssessmentAttempts")

  @@index([email])
  @@index([clerkId])
}

// Matching profile for a candidate. Splits cleanly in two:
//  - preferences the candidate sets by hand (location, pay, mobility)
//  - a snapshot of skills/experience lifted from their latest resume analysis
// Both feed utils/matchEngine so a match can be scored without re-parsing a CV.
model CandidateProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Candidate-controlled preferences
  location              String?
  expectedSalaryMin     Float?
  expectedSalaryMax     Float?
  salaryCurrency        String   @default("GH₵")
  salaryPeriod          String   @default("month")
  willingToRelocate     Boolean  @default(false)
  openToRemote          Boolean  @default(true)
  targetRoles           String[] @default([])

  // Snapshot from the most recent resume analysis
  skills                String[] @default([])
  softSkills            String[] @default([])
  certifications        String[] @default([])
  industries            String[] @default([])
  yearsOfExperience     Float?
  highestEducationLevel String?
  seniority             String?
  headline              String?
  resumeAnalysisId      String?
  profileSyncedAt       DateTime?

  // Opt-in visibility to verified employers in Talent Search. Off by default:
  // applying to one employer never makes a candidate findable by the rest.
  discoverable          Boolean  @default(false)
  discoverableAt        DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([discoverable])
}

// One stored AI resume analysis. Keyed by a hash of the extracted text so an
// unchanged resume is never billed to Groq twice.
model ResumeAnalysis {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String?
  resumeUrl     String?
  resumeHash    String
  targetRole    String?
  targetJobId   String?

  overallScore  Int
  atsScore      Int
  qualityScore  Int
  grammarScore  Int?

  wordCount     Int?
  pageCount     Int?
  multiColumn   Boolean  @default(false)

  // Full payloads kept as JSON — the shapes are presentation detail and
  // querying inside them is never needed.
  profile       Json
  atsChecks     Json
  atsSections   Json?
  atsSignals    Json?
  quality       Json
  grammar       Json
  missingSkills Json
  suggestions   Json
  keywords      Json?
  redFlags      Json?

  resumeText    String?
  model         String?
  degraded      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, resumeHash])
}

// AI-extracted structured requirements for a job posting. Cached per job and
// re-extracted only when the posting text changes (tracked by sourceHash).
model JobRequirementSpec {
  id                     String   @id @default(cuid())
  jobId                  String   @unique
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  requiredSkills         String[] @default([])
  preferredSkills        String[] @default([])
  requiredCertifications String[] @default([])
  keyResponsibilities    String[] @default([])
  requiredYears          Int?
  requiredEducationLevel String?
  seniority              String?
  workModel              String?
  sourceHash             String
  model                  String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// A candidate-facing match score for one job. Cached so listing pages are fast
// and invalidated when the candidate's resume analysis changes.
model JobMatch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore    Int
  verdict       String
  dimensions    Json
  strengths     String[] @default([])
  gaps          String[] @default([])
  missingSkills String[] @default([])
  aiSummary     String?
  aiAdjustment  Int?
  profileKey    String?
  model         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@index([jobId])
}

// An employer-facing score for one application, so a recruiter can rank a
// shortlist by fit instead of by arrival order.
model ApplicantScore {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobId          String

  matchScore     Int
  verdict        String
  dimensions     Json
  strengths      String[] @default([])
  gaps           String[] @default([])
  aiSummary      String?
  recommendation String?
  interviewFocus String[] @default([])
  model          String?
  degraded       Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([jobId, matchScore])
}

model Document {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  url          String
  category     String   @default("Other")
  fileType     String?
  size         Int?
  publicId     String?
  resourceType String?
  uploadedAt   DateTime @default(now())

  @@index([userId])
}

// Company profile — rich employer-managed company page
model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  logo        String?
  cover       String?
  description String?
  hq          String?
  stage       String?
  employees   String?
  industry    String?
  website     String?
  legalName   String?
  organizationType String?
  registrationNumber String?
  contactName String?
  contactTitle String?
  contactEmail String?
  contactPhone String?
  authorityConfirmedAt DateTime?
  termsAcceptedAt DateTime?
  hiringPolicyAcceptedAt DateTime?
  rating      Float?   @default(0)
  // The public badge. Driven by `approvalState` rather than set by hand — a
  // company is "verified" precisely because a reviewer approved it.
  verified    Boolean  @default(false)

  // pending | approved | rejected. A company must be approved before it can
  // publish jobs. Unapproved companies still appear in the public directory,
  // they simply carry no badge and cannot post. New rows start pending; the
  // companies that existed before review was introduced were approved in bulk.
  approvalState      String    @default("pending")
  approvalNote       String?
  reviewedAt         DateTime?
  reviewedById       String?
  submittedForReviewAt DateTime?
  // Business registration certificate, supplied at onboarding and the main
  // thing a reviewer is looking at.
  registrationDocUrl   String?
  registrationDocName  String?
  // clear | flagged | rejected — the automated trust signal, distinct from the
  // editorial `verified` badge above.
  trustState  String   @default("clear")
  stack       String[]
  perks       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]    @relation("CompanyJobs")

  @@index([industry])
  @@index([approvalState])
}

model Job {
  id               String        @id @default(cuid())
  title            String
  description      String
  requirements     String
  location         String?
  latitude         Float?
  longitude        Float?
  category         String?
  customCategory   String?
  tags             String[]      @default([])
  type             String
  workModel        String?
  customJobType    String?
  deadline         DateTime?
  companyId        String
  company          User          @relation("EmployerJobs", fields: [companyId], references: [id], onDelete: Cascade)
  companyProfileId String?
  companyProfile   Company?      @relation("CompanyJobs", fields: [companyProfileId], references: [id], onDelete: SetNull)
  salaryMin        Float?
  salaryMax        Float?
  isClosed         Boolean       @default(false)
  // Soft delete. A removed advert keeps its row so applications, saved jobs
  // and match history still point at something real — a candidate's record of
  // applying should outlive the employer taking the advert down. `null` means
  // live; every public read filters on it.
  deletedAt        DateTime?
  // clear | flagged | hidden. Only `hidden` removes a job from public listings;
  // `flagged` stays live so a false positive never silently kills a real advert.
  moderationState  String        @default("clear")
  contentHash      String?
  duplicateOfId    String?
  jobType          String?
  companyLogo      String?

  // Search facets read out of the advert when it is written, by
  // utils/jobFacets. Employers never type these in — the information is
  // already in the title and requirements — but a filter can only be exact
  // and fast if the value it filters on is a column. Existing rows are
  // filled in by scripts/backfillJobFacets.js.
  // intern | entry | mid | senior | lead | executive
  seniority        String?
  // secondary | certificate | diploma | bachelor | master | doctorate
  educationLevel   String?
  // Canonical skills, so a skills filter never depends on free text.
  searchSkills     String[]      @default([])

  // Employer-specific questions asked when applying — see
  // utils/screeningQuestions for the shape. Null or empty means none.
  screeningQuestions Json?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications     Application[]
  savedBy          SavedJob[]
  requirementSpec  JobRequirementSpec?
  matches          JobMatch[]
  talentInvites    TalentInvite[]
  assessments      Assessment[]

  @@index([companyId])
  @@index([companyProfileId])
  @@index([category])
  @@index([isClosed])
  @@index([moderationState])
  @@index([contentHash])
  @@index([deletedAt])
  @@index([seniority])
  @@index([educationLevel])
  @@index([createdAt])
}

model Application {
  id                String    @id @default(cuid())
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId       String?
  applicant         User?     @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: SetNull)
  guestName         String?
  guestEmail        String?
  guestPhone        String?
  resume            String
  coverLetter       String?
  coverLetterFile   String?
  // A stage id from the employer's HiringPipeline (or the default one), or
  // "rejected". Candidates never see it — only the phase it maps to.
  status            String    @default("applied")
  // The screening questions as asked and the answers given, so later edits
  // to the job's questions never rewrite what an applicant said.
  screeningAnswers  Json?
  interviewDate     DateTime?
  interviewTime     String?
  interviewLocation String?
  interviewNotes    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  aiScore           ApplicantScore?
  interviewGuide    InterviewGuide?
  assessmentAttempts AssessmentAttempt[]

  @@index([jobId])
  @@index([applicantId])
  // One application per job per account. Postgres treats NULLs as distinct, so
  // this constrains signed-in applicants only and leaves guest rows (which
  // carry no applicantId) alone. The controller's own check gives the friendly
  // message; this is what makes the rule true when two submits race.
  @@unique([jobId, applicantId])
}

// The stages an employer moves applications through. One per employer; an
// employer without a row uses the default pipeline in utils/hiringPipeline.
// Kept off Company because public job reads include the whole company row, and
// an employer's internal stage names are not public.
model HiringPipeline {
  id         String   @id @default(cuid())
  employerId String   @unique
  employer   User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  stages     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// AI-generated interview questions for one application. Employer-only: no
// candidate-facing read includes this relation.
model InterviewGuide {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questions     Json
  // Whether the questions used this applicant's profile and fit gaps, or only
  // the job.
  tailored      Boolean     @default(false)
  // Written from templates because AI was unavailable.
  degraded      Boolean     @default(false)
  model         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// An employer inviting a candidate found in Talent Search to apply. The
// candidate is emailed; the employer never sees their address.
model TalentInvite {
  id          String   @id @default(cuid())
  employerId  String
  employer    User     @relation("TalentInvitesSent", fields: [employerId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   User     @relation("TalentInvitesReceived", fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([candidateId, jobId])
  @@index([employerId, createdAt])
}

// A test an employer builds and sends to applicants. Questions live here while
// it is being edited; each attempt keeps its own copy from the moment it was
// sent, so editing an assessment never changes a test someone is taking.
// See utils/assessmentQuestions for the question shape.
model Assessment {
  id               String   @id @default(cuid())
  employerId       String
  employer         User     @relation("EmployerAssessments", fields: [employerId], references: [id], onDelete: Cascade)
  // Optional: an assessment tied to a job is sent to that job's applicants.
  jobId            String?
  job              Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title            String
  instructions     String?
  questions        Json
  // null means untimed.
  timeLimitMinutes Int?
  passMark         Int      @default(60)
  defaultDueDays   Int      @default(7)
  // draft | active | archived
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  attempts         AssessmentAttempt[]

  @@index([employerId, status])
}

// One applicant's sitting of an assessment.
model AssessmentAttempt {
  id               String      @id @default(cuid())
  assessmentId     String
  assessment       Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        User        @relation("CandidateAssessmentAttempts", fields: [candidateId], references: [id], onDelete: Cascade)
  // invited | in_progress | submitted | scored. "expired" is derived from dueAt.
  status           String      @default("invited")
  // The questions as sent, answer key included. Never sent to the candidate
  // with the key.
  questions        Json
  timeLimitMinutes Int?
  passMark         Int
  invitedAt        DateTime    @default(now())
  dueAt            DateTime
  startedAt        DateTime?
  submittedAt      DateTime?
  // { [questionId]: { value, autoPoints, points, note } }
  answers          Json?
  score            Float?
  maxScore         Float
  percent          Int?
  scoredAt         DateTime?
  scoredById       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([assessmentId, applicationId])
  @@index([candidateId])
  @@index([assessmentId, status])
}

// What one CV looks like to the duplicate detector: its file, its wording and
// the contact details in its header. Keyed by where the CV came from — a
// stored file URL (immutable per upload) or "analysis:<id>" for analysed text
// — so each CV is read once, however many times detection runs.
model CvFingerprint {
  id        String   @id @default(cuid())
  sourceKey String   @unique
  fileHash  String?
  textHash  String?
  // MinHash signature of the wording; see utils/identitySignals.
  minhash   Int[]    @default([])
  emails    String[] @default([])
  phones    String[] @default([])
  // The CV could not be read. Kept so it is not downloaded again every scan.
  failed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fileHash])
  @@index([textHash])
}

// A human decision about two identities the detector paired: the same person,
// or different people. Scope is "platform" for admins, "employer:<userId>" for
// an employer's own applicants. Identities are "user:<id>" or "guest:<email>".
model DuplicateReview {
  id          String   @id @default(cuid())
  scope       String
  pairKey     String
  decision    String   // same | distinct
  note        String?
  decidedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, pairKey])
}

model SavedJob {
  id          String   @id @default(cuid())
  jobSeekerId String
  jobSeeker   User     @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([jobSeekerId, jobId])
  @@index([jobSeekerId])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @default("")
  subject     String
  html        String
  variables   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Analytics {
  id                String   @id @default(cuid())
  employerId        String   @unique
  employer          User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  totalJobsPosted   Int      @default(0)
  totalApplications Int      @default(0)
  totalHired        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Salary benchmark data — admin-managed market compensation data
model SalaryBenchmark {
  id        String   @id @default(cuid())
  role      String
  location  String?
  sector    String?
  tenure    String?
  p25       Float
  median    Float
  p75       Float
  p90       Float
  currency  String   @default("GH₵")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// Skill premium data — admin-managed
model SkillPremium {
  id        String   @id @default(cuid())
  skill     String
  premium   String
  demand    String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Anonymous salary submissions from users
model SalarySubmission {
  id           String   @id @default(cuid())
  role         String
  compensation String
  experience   String
  location     String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust & Safety
//
// Fraud detection runs in two layers. Deterministic rules in utils/fraudSignals
// produce the signals and the base score — reproducible, explainable, and not
// influenced by anything a fraudster writes. An AI adjudication pass may then
// nudge that score within a hard cap and explain itself in plain language.
// Both are recorded so a reviewer can see exactly why something was flagged.
// ─────────────────────────────────────────────────────────────────────────────

model RiskAssessment {
  id           String   @id @default(cuid())
  entityType   String   // company | job | user | resume
  entityId     String
  category     String   // fake_company | duplicate_job | spam_recruiter | fake_resume
  score        Int      // final 0-100 risk after any AI adjustment
  band         String   // low | medium | high | critical
  ruleScore    Int      // deterministic score before AI
  aiAdjustment Int      @default(0)
  aiVerdict    String?
  aiConfidence Int?
  signals      Json     // the deterministic rule hits behind ruleScore
  aiReasons    Json?
  model        String?
  degraded     Boolean  @default(false) // true when AI was unavailable
  createdAt    DateTime @default(now())

  moderationCase ModerationCase?

  @@index([entityType, entityId, createdAt])
  @@index([category, band])
}

model ModerationCase {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  category     String
  score        Int
  band         String
  state        String    @default("open") // open | in_review | actioned | dismissed
  summary      String
  autoAction   String?   // what enforcement fired automatically, if any
  assessmentId String?   @unique
  assessment   RiskAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  decision     String?   // upheld | dismissed
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       ModerationEvent[]

  @@index([state, band, createdAt])
  @@index([entityType, entityId, state])
  @@index([category, state])
}

model ModerationEvent {
  id        String         @id @default(cuid())
  caseId    String
  case      ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action    String
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime       @default(now())

  @@index([caseId, createdAt])
}
