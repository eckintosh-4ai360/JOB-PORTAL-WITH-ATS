PORT=8000
# Neon may need longer than Prisma's default five seconds to wake its compute.
# Keep this timeout on both the pooled app URL and the direct Prisma CLI URL.
DATABASE_URL="postgresql://user:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
JWT_SECRET=supersecretjwtkey_ats_portal_2026
CLERK_SECRET_KEY=sk_test_placeholder_key
FRONTEND_URL=http://localhost:5173
# Where this API is reachable from the public internet. Job update emails
# link their unsubscribe footer here, so it has to work from a mail client.
API_PUBLIC_URL=http://localhost:8000
RESEND_API_KEY=re_placeholder_key
EMAIL_FROM="Job Portal <onboarding@resend.dev>"

# --- AI (Groq) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT_MS=60000
# How far AI refinement may move a rule-based match score, in points
AI_MATCH_MAX_ADJUSTMENT=8
# Max open jobs scored per match request
AI_MAX_MATCH_JOBS=40
